<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FiscalService.Api</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MediatR" Version="12.4.1" />
    <!-- Core apenas: a validacao roda no ValidationBehavior (Application), nao no
         auto-validation do ASP.NET. A Api so precisa de ValidationException. -->
    <PackageReference Include="FluentValidation" Version="11.11.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.9.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FiscalService.Application\FiscalService.Application.csproj" />
    <ProjectReference Include="..\FiscalService.Infrastructure\FiscalService.Infrastructure.csproj" />
  </ItemGroup>

</Project>
